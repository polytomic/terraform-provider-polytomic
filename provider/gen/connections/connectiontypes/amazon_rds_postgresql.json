{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"hostname":{"type":"string","title":"RDS endpoint","description":"The Amazon RDS endpoint; custom DNS names cannot be used to generate IAM authentication tokens","examples":["database.123456789012.us-east-1.rds.amazonaws.com"]},"username":{"type":"string","title":"Username","examples":["polytomic"]},"database":{"type":"string","title":"Database","examples":["sampledb"]},"port":{"type":"integer","title":"Port","default":5432,"examples":[5432]},"region":{"type":"string","title":"AWS region","examples":["us-east-1"]},"iam_role_arn":{"type":"string","title":"IAM role ARN","description":"Role that grants rds-db:connect access to this database user","examples":["arn:aws:iam::123456789012:role/polytomic-rds"]},"external_id":{"type":"string","title":"External ID","description":"External ID for the IAM role","readOnly":true},"tags":{"additionalProperties":{"type":"string"},"type":"object","title":"Tags","description":"Additional tags to apply during role assumption"},"ssh":{"type":"boolean","title":"Connect over SSH tunnel"},"ssh_user":{"type":"string","title":"SSH user","default":"root"},"ssh_host":{"type":"string","title":"SSH host","examples":["bastion.example.com"]},"ssh_port":{"type":"integer","title":"SSH port","default":22,"examples":[22]},"ssh_private_key":{"type":"string","title":"Private key","sensitive":true},"change_detection":{"type":"boolean","title":"Use logical replication for bulk syncs","default":false},"publication":{"type":"string","title":"Publication","examples":["polytomic"]}},"type":"object","required":["hostname","username","database","port","region","iam_role_arn"]}
